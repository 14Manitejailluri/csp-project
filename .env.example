# Frontend Environment
VITE_API_URL=http://localhost:5000/api

# Backend Environment
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/foodrescue
JWT_SECRET=foodrescue_super_secret_jwt_key_2026_change_in_prod
JWT_EXPIRES_IN=7d
